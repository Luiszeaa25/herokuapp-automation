[
  {
    "name": "Assertion failures",
    "messageRegex": ".*AssertionError.*|.*expect.*received.*",
    "matchedStatuses": ["failed"]
  },
  {
    "name": "Navigation errors",
    "messageRegex": ".*navigation.*|.*goto.*|.*URL.*",
    "matchedStatuses": ["failed", "broken"]
  },
  {
    "name": "Timeout errors",
    "messageRegex": ".*timeout.*|.*Timeout.*",
    "matchedStatuses": ["failed", "broken"]
  },
  {
    "name": "Element not found",
    "messageRegex": ".*locator.*|.*element.*not.*found.*|.*waiting for.*",
    "matchedStatuses": ["failed", "broken"]
  },
  {
    "name": "Skipped tests",
    "matchedStatuses": ["skipped"]
  },
  {
    "name": "Unknown errors",
    "messageRegex": ".*Error.*",
    "matchedStatuses": ["failed", "broken"]
  }
]
